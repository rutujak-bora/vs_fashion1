[Unit]
Description=VS Fashion Backend API
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/backend/backend
Environment="PATH=/home/ubuntu/backend/backend/venv/bin"
ExecStart=/home/ubuntu/backend/backend/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000

[Install]
WantedBy=multi-user.target
